# ============================================================
# WebGuard Pro — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git!
# ============================================================

# Django Core
SECRET_KEY=your-super-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=webguard.settings.development

# ============================================================
# Database — PostgreSQL
# ============================================================
DB_NAME=webguard_db
DB_USER=webguard_user
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================
# JWT Settings
# ============================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=your-jwt-signing-key-here

# ============================================================
# Email — SendGrid
# ============================================================
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
DEFAULT_FROM_EMAIL=noreply@webguardpro.com
SUPPORT_EMAIL=support@webguardpro.com

# ============================================================
# Frontend URL (for CORS + email links)
# ============================================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ============================================================
# Stripe Payments
# ============================================================
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Stripe Price IDs
STRIPE_PRICE_PRO_MONTHLY=price_your-pro-monthly-id
STRIPE_PRICE_PRO_YEARLY=price_your-pro-yearly-id
STRIPE_PRICE_BUSINESS_MONTHLY=price_your-business-monthly-id
STRIPE_PRICE_BUSINESS_YEARLY=price_your-business-yearly-id
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_your-enterprise-monthly-id
STRIPE_PRICE_ENTERPRISE_YEARLY=price_your-enterprise-yearly-id

# ============================================================
# JazzCash Payments (Pakistan)
# ============================================================
JAZZCASH_MERCHANT_ID=your-jazzcash-merchant-id
JAZZCASH_PASSWORD=your-jazzcash-password
JAZZCASH_INTEGRITY_SALT=your-jazzcash-salt
JAZZCASH_API_URL=https://sandbox.jazzcash.com.pk/ApplicationAPI/API/2.0/Purchase

# ============================================================
# EasyPaisa Payments (Pakistan)
# ============================================================
EASYPAISA_STORE_ID=your-easypaisa-store-id
EASYPAISA_ACCOUNT_NUM=your-easypaisa-account
EASYPAISA_HASH_KEY=your-easypaisa-hash-key
EASYPAISA_API_URL=https://easypay.easypaisa.com.pk/easypay-service/rest/v4/initiation/

# ============================================================
# AWS S3 / Cloudflare R2 (PDF Report Storage)
# ============================================================
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=webguard-reports
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
# For Cloudflare R2 (alternative):
# AWS_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# ============================================================
# Claude AI (Anthropic)
# ============================================================
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# ============================================================
# Google PageSpeed Insights API
# ============================================================
GOOGLE_PAGESPEED_API_KEY=your-google-api-key-here

# ============================================================
# OWASP ZAP (Pro Scan Engine)
# ============================================================
ZAP_API_KEY=your-zap-api-key
ZAP_HOST=localhost
ZAP_PORT=8080

# ============================================================
# Security
# ============================================================
# HMAC secret for email verification tokens
EMAIL_HMAC_SECRET=your-email-hmac-secret-here
# HMAC secret for report integrity
REPORT_HMAC_SECRET=your-report-hmac-secret-here

# ============================================================
# Sentry (Error Monitoring)
# ============================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================
# Rate Limiting
# ============================================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=15

# ============================================================
# Google OAuth 2.0
# ============================================================
# Get from: https://console.cloud.google.com/ → Credentials → OAuth 2.0 Client IDs
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ============================================================
# Development Shortcuts
# ============================================================
# Set to True (default) to use SQLite in development instead of PostgreSQL
USE_SQLITE=True
# Set to True to run Celery tasks synchronously (no worker needed in dev)
CELERY_TASK_ALWAYS_EAGER=False
